{
  "name": "diplomatic-atlas",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-01-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "AI_LIMITER", "class_name": "AnalysisLimiter"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AnalysisLimiter"]}]
}
