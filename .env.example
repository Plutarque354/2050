# Copy to .env locally; never commit real values.
GEMINI_API_KEY=
# Free-tier model; change if your Gemini account offers another supported model.
GEMINI_MODEL=gemini-2.5-flash
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_TOKEN=
# Optional output language override:
AI_LANGUAGE=
PORT=3000
HOST=127.0.0.1
